  "description": "Arch Constroi – Engenharia e Construção Civil. Website institucional + Painel Administrativo em Cloudflare Workers (JavaScript). Desenvolvido por Tech J Innovative Solutions.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 8080",
